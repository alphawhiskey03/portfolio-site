---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutSection from "../components/astro/AboutSection.astro";
import Experience from "../components/astro/Experience.astro";
import TechStack from "../components/astro/TechStack.astro";
import WhatIDo from "../components/astro/WhatIDo.astro";
import Heading from "../components/astro/Heading.astro";
import { FaHouse } from "react-icons/fa6";
import { sanityClient } from "sanity:client";
import { GET_MAINCONTENT, GET_EXPERIENCES } from "@/queries";
import type {
  MainContentResponse,
  ExperiencesResponse,
} from "@/queries/types";

const mainContent =
  await sanityClient.fetch<MainContentResponse>(GET_MAINCONTENT);
const experiences =
  await sanityClient.fetch<ExperiencesResponse>(GET_EXPERIENCES);
---

<BaseLayout title="About | Vignesh Shanmugavelu">
  <nav
    id="about-nav"
    class="fixed
    top-0
    left-0
    right-0
    z-50
    -translate-y-full
    opacity-0
    transition-all
    duration-300
    ease-in-out
    backdrop-blur-md
    bg-black/30"
  >
    <div class="px-6
    py-6
    flex
    items-center
    lg:px-10
    lg:py-10">
      <a
        href="/"
        class="flex
           items-center
           gap-2
           text-sm
           text-neutral-300
           hover:text-white transition-colors
           border border-white/20 rounded-md p-2"
      >
        <FaHouse />
      </a>
    </div>
  </nav>

  <div class="flex flex-col items-center justify-center">
    <!-- Content -->
    <div class="flex flex-col lg:w-3/4 gap-10">
      <AboutSection
        name="Vignesh Shanmugavelu"
        role={mainContent.role}
        currently="building product features at Userflow x Beamer"
        aboutMe={mainContent.aboutMe}
        email={mainContent.email}
      />
      <div id="work-experience">
        <Heading className="lg:text-4xl text-center">Work Experience</Heading>
        <Experience items={experiences} timeline />
      </div>
      <div id="tech-stack">
        <Heading className="lg:text-4xl text-center">Tech Stack</Heading>
        <TechStack />
      </div>
      <div id="what-i-do">
        <Heading className="lg:text-4xl text-center">What I Do</Heading>
        <WhatIDo centerContent />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const nav = document.getElementById("about-nav");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      nav?.classList.remove("-translate-y-full", "opacity-0");
      nav?.classList.add("translate-y-0", "opacity-100");
    } else {
      nav?.classList.add("-translate-y-full", "opacity-0");
      nav?.classList.remove("translate-y-0", "opacity-100");
    }
  });
</script>
