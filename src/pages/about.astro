---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutSection from "../components/astro/AboutSection.astro";
import TechStack from "../components/astro/TechStack.astro";
import WhatIDo from "../components/astro/WhatIDo.astro";
import Heading from "../components/astro/Heading.astro";
import { FaHouse } from "react-icons/fa6";
import { sanityClient } from "sanity:client";
import { GET_MAINCONTENT } from "@/queries";

const mainContent = await sanityClient.fetch(GET_MAINCONTENT);
---

<BaseLayout title="About | Vignesh Shanmugavelu">
  <nav
    id="about-nav"
    class="fixed
    top-0
    left-0
    right-0
    z-50
    -translate-y-full
    opacity-0
    transition-all
    duration-300
    ease-in-out
    backdrop-blur-md
    bg-black/30"
  >
    <div class="px-6
    py-6
    flex
    items-center
    lg:px-10
    lg:py-10">
      <a
        href="/"
        class="flex
           items-center
           gap-2
           text-sm
           text-neutral-300
           hover:text-white transition-colors
           border border-white/20 rounded-md p-2"
      >
        <FaHouse />
      </a>
    </div>
  </nav>

  <div class="flex flex-col items-center justify-center">
    <div class="flex flex-col items-center mb-10">
      <h1 class="text-center mb-4">
        <span
          class="inline-flex flex-wrap items-center justify-center gap-x-2 text-5xl font-bold text-transparent bg-clip-text bg-linear-to-b from-white via-white to-zinc-500 font-space"
        >
          Vignesh Shanmugavelu
          <span class="text-4xl">|</span>
          <span class="text-xl text-blue-300">
            Software Development Engineer</span
          >
        </span>
      </h1>
      <p class="text-center font-mono w-3/4">
        {mainContent.aboutMe}
      </p>
    </div>
    <!-- Content -->
    <div class="flex flex-col lg:w-3/4 gap-10">
      <div id="work-experience">
        <Heading className="lg:text-4xl text-center">Work Experience</Heading>
        <AboutSection expanded={true} />
      </div>
      <div id="tech-stack">
        <Heading className="lg:text-4xl text-center">Tech Stack</Heading>
        <TechStack />
      </div>
      <div id="what-i-do">
        <Heading className="lg:text-4xl text-center">What I Do</Heading>
        <WhatIDo centerContent />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const nav = document.getElementById("about-nav");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      nav?.classList.remove("-translate-y-full", "opacity-0");
      nav?.classList.add("translate-y-0", "opacity-100");
    } else {
      nav?.classList.add("-translate-y-full", "opacity-0");
      nav?.classList.remove("translate-y-0", "opacity-100");
    }
  });
</script>
