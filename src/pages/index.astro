---
import SectionWrapper from "../components/astro/SectionWrapper.astro";
import AboutSection from "../components/astro/AboutSection.astro";
import Heading from "../components/astro/Heading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import TechStack from "../components/astro/TechStack.astro";
import WhatIDo from "../components/astro/WhatIDo.astro";
import Hero from "../components/astro/Hero.astro";
import Experience from "../components/astro/Experience.astro";
import ExperienceIndex from "../components/astro/ExperienceIndex.astro";

import ContactForm from "../components/client/ContactForm";
import Links from "../components/client/Links";
import { sanityClient } from "sanity:client";
import { GET_MAINCONTENT, GET_EXPERIENCES, GET_SOCIALMEDIA } from "@/queries";
import type {
  MainContentResponse,
  ExperiencesResponse,
  SocialMediaResponse,
} from "@/queries/types";

const mainContent =
  await sanityClient.fetch<MainContentResponse>(GET_MAINCONTENT);
const experiences =
  await sanityClient.fetch<ExperiencesResponse>(GET_EXPERIENCES);
const socials = await sanityClient.fetch<SocialMediaResponse>(GET_SOCIALMEDIA);
---

<BaseLayout
  nav={[
    { label: "About", id: "about-me" },
    { label: "Experience", id: "experience" },
    { label: "Contact", id: "contact-me" },
  ]}
>
  <form name="contact" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="text" name="name" />
    <input type="email" name="email" />
    <textarea name="query"></textarea>
  </form>

  <Hero
    role={mainContent.role}
    basedIn={`${mainContent.city}, ${mainContent.country}`}
  />

  <SectionWrapper id="about-me">
    <Fragment slot="header">
      <Heading>About Me</Heading>
    </Fragment>

    <Fragment slot="content">
      <AboutSection
        aboutMe={mainContent.gist}
        email={mainContent.email}
        socials={socials}
        currently="building product features at Userflow x Beamer"
      />
    </Fragment>
  </SectionWrapper>

  <SectionWrapper id="experience">
    <Fragment slot="header">
      <Heading>Experience</Heading>
      <ExperienceIndex items={experiences} />
    </Fragment>
    <Fragment slot="content">
      <Experience items={experiences} />
    </Fragment>
  </SectionWrapper>

  <SectionWrapper id="tech-stack">
    <Fragment slot="header">
      <Heading>Tech Stack</Heading>
    </Fragment>
    <Fragment slot="content">
      <TechStack takeFullWidth />
    </Fragment>
  </SectionWrapper>

  <!-- Temporarily removed until I can figure out a better way to present this section
  <SectionWrapper id="what-i-do">
    <Fragment slot="header">
      <Heading>What I Do</Heading>
    </Fragment>
    <Fragment slot="content">
      <WhatIDo centerContent />
    </Fragment>
  </SectionWrapper> -->

  <SectionWrapper id="contact-me">
    <Fragment slot="header">
      <div class="flex flex-col">
        <Heading>Contact</Heading>
        <div
          class="flex flex-col gap-5 items-center text-center mb-8 lg:items-start lg:text-left"
        >
          <a
            href="mailto:vigneshshanmugavelu03@gmail.com"
            class="group font-space text-base font-medium tracking-tight text-white [overflow-wrap:anywhere] sm:text-lg lg:text-xl"
          >
            <span
              class="text-blue-300 transition-colors group-hover:text-blue-200"
              >vigneshshanmugavelu03</span
            >@gmail.com
          </a>
          <a
            href="https://maps.app.goo.gl/L91iPn9L8ZRcjhq79"
            target="_blank"
            rel="noopener noreferrer"
            class="text-base text-neutral-400 transition-colors hover:text-white"
            >Coimbatore, India</a
          >
          <Links client:load viewMode="icon" />
        </div>
      </div>
    </Fragment>

    <Fragment slot="content">
      <ContactForm client:visible />
    </Fragment>
  </SectionWrapper>
</BaseLayout>
