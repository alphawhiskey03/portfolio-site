---
import SectionWrapper from "../components/astro/SectionWrapper.astro";
import AboutSection from "../components/astro/AboutSection.astro";
import Heading from "../components/astro/Heading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import TechStack from "../components/astro/TechStack.astro";
import WhatIDo from "../components/astro/WhatIDo.astro";
import Hero from "../components/astro/Hero.astro";

import ContactForm from "../components/client/ContactForm";
import Links from "../components/client/Links";
---

<BaseLayout title="Portfolio">
  <Hero />
  <SectionWrapper id="about-me" className="lg:items-center">
    <Fragment slot="header">
      <Heading>About Me</Heading>
    </Fragment>

    <Fragment slot="content">
      <AboutSection />
    </Fragment>
  </SectionWrapper>

  <SectionWrapper id="tech-stack">
    <Fragment slot="header">
      <Heading>Tech Stack</Heading>
    </Fragment>

    <Fragment slot="content">
      <TechStack takeFullWidth />
    </Fragment>
  </SectionWrapper>

  <SectionWrapper id="what-i-do">
    <Fragment slot="header">
      <Heading>What I Do</Heading>
    </Fragment>

    <Fragment slot="content">
      <WhatIDo centerContent />
    </Fragment>
  </SectionWrapper>

  <SectionWrapper id="contact-me">
    <Fragment slot="header">
      <div class="flex flex-col">
        <Heading>Contact Me</Heading>
        <div class="mb-8">
          <Links client:load />
        </div>
      </div>
    </Fragment>

    <Fragment slot="content">
      <ContactForm client:load />
    </Fragment>
  </SectionWrapper>
</BaseLayout>
