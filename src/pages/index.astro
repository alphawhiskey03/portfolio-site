---
import SectionWrapper from "../components/astro/SectionWrapper.astro";
import AboutSection from "../components/astro/AboutSection.astro";
import Heading from "../components/astro/Heading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import TechStack from "../components/astro/TechStack.astro";
import WhatIDo from "../components/astro/WhatIDo.astro";
import Hero from "../components/astro/Hero.astro";

import ContactForm from "../components/client/ContactForm";
import Links from "../components/client/Links";
import { sanityClient } from "sanity:client";
import { GET_MAINCONTENT } from "@/queries";

const mainContent = await sanityClient.fetch(GET_MAINCONTENT);
---

<BaseLayout>
  <form name="contact" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="text" name="name" />
    <input type="email" name="email" />
    <textarea name="query"></textarea>
  </form>
  <Hero role={mainContent.role} />
  <SectionWrapper id="about-me" className="lg:items-center">
    <Fragment slot="header">
      <Heading>About Me</Heading>
    </Fragment>

    <Fragment slot="content">
      <AboutSection aboutMe={mainContent.aboutMe} />
    </Fragment>
  </SectionWrapper>

  <SectionWrapper id="tech-stack">
    <Fragment slot="header">
      <Heading>Tech Stack</Heading>
    </Fragment>
    <Fragment slot="content">
      <TechStack takeFullWidth />
    </Fragment>
  </SectionWrapper>

  <SectionWrapper id="what-i-do">
    <Fragment slot="header">
      <Heading>What I Do</Heading>
    </Fragment>
    <Fragment slot="content">
      <WhatIDo centerContent />
    </Fragment>
  </SectionWrapper>

  <SectionWrapper id="contact-me">
    <Fragment slot="header">
      <div class="flex flex-col">
        <Heading>Contact</Heading>
        <div class="flex flex-col gap-4 items-center mb-8 lg:items-start">
          <Links client:load />
          <a
            href="mailto:vigneshshanmugavelu03@gmail.com"
            class="text-mono text-gray-200">vigneshshanmugavelu03@gmail.com</a
          >
          <a
            href="https://maps.app.goo.gl/L91iPn9L8ZRcjhq79"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-sm">Coimbatore, India</a
          >
        </div>
      </div>
    </Fragment>

    <Fragment slot="content">
      <ContactForm client:load />
    </Fragment>
  </SectionWrapper>
</BaseLayout>
