---
import { ResumeButton } from "../client/ResumeButton";

interface Props {
  aboutMe: string;
  email: string;
  currently: string;
  /** Optional header; used on /about where this card is the page intro */
  name?: string;
  role?: string;
}

const { aboutMe, email, currently, name, role } = Astro.props;

const RESUME_PATH = "/resume.pdf";

const contacts = [
  { label: email, href: `mailto:${email}` },
  {
    label: "linkedin.com/in/vignesh-s-802812183",
    href: "https://www.linkedin.com/in/vignesh-s-802812183/",
  },
  {
    label: "github.com/alphawhiskey03",
    href: "https://github.com/alphawhiskey03",
  },
  { label: "therealvig.app", href: "https://therealvig.app" },
];
---

<div
  class="w-full
  rounded-xl
  border
  border-white/10
  bg-white/5
  p-6
  backdrop-blur-md
  shadow-lg
  shadow-black/20"
>
  {
    name && (
      <div class="mb-4">
        <h1 class="font-space text-3xl font-bold tracking-tight text-transparent bg-clip-text bg-linear-to-b from-white via-white to-zinc-500 lg:text-4xl">
          {name}
        </h1>
        {role && <p class="mt-1 font-mono text-blue-300">{role}</p>}
      </div>
    )
  }

  <p
    class="mb-4 inline-flex items-start gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-1.5 font-mono text-xs leading-4 sm:rounded-full"
  >
    <span aria-hidden="true" class="relative mt-1 flex h-2 w-2 shrink-0">
      <span
        class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-300 opacity-60"
      ></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-blue-300"
      ></span>
    </span>
    <span class="text-neutral-200">
      <span class="text-neutral-400">Currently:</span>
      {currently}
    </span>
  </p>

  <p class="leading-relaxed text-neutral-300">{aboutMe}</p>

  <div
    class="mt-5 flex flex-col gap-4 border-t border-white/10 pt-5 sm:flex-row sm:items-start sm:justify-between"
  >
    <ul class="flex flex-col gap-2 font-mono text-sm">
      {
        contacts.map(({ label, href }) => (
          <li class="flex items-center gap-3">
            <span
              aria-hidden="true"
              class="h-1.5 w-1.5 shrink-0 rounded-full bg-blue-300"
            />
            <a
              href={href}
              target={href.startsWith("mailto:") ? undefined : "_blank"}
              rel={
                href.startsWith("mailto:") ? undefined : "noopener noreferrer"
              }
              class="text-neutral-300 transition-colors hover:text-blue-300"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="shrink-0 self-start sm:self-auto">
      <ResumeButton client:load href={RESUME_PATH} />
    </div>
  </div>
</div>
