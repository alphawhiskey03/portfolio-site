---
import { GET_EXPEREINCES } from "@/queries";
import TestimonialsCard from "../vengance-ui/experience-card";
import { FaExpand } from "react-icons/fa";
import { sanityClient } from "sanity:client";
import type { Experience } from "@/queries/types";
import { urlFor } from "@/utils";

const { expanded = false, aboutMe } = Astro.props;
const experiences: Experience[] = await sanityClient.fetch(GET_EXPEREINCES);
---

{
  !expanded ? (
    <div class="flex-1 flex flex-col items-start">
      <p
        class="text-lg
        drop-shadow-sm
        w-full
        "
      >
        {aboutMe}
      </p>

      <div class="flex flex-row justify-between items-center w-full my-8">
        <p class="text-xl font-bold text-white">Work Experience</p>
        <button
          id="expand-btn"
          class="flex 
          items-center 
          gap-2 
          text-sm 
          text-neutral-400 
          cursor-pointer 
          lg:mr-16
          hover:text-white 
          transition-colors"
        >
          <FaExpand />
          <span>Expand</span>
        </button>
      </div>
      <TestimonialsCard client:load width={600} items={experiences} />
    </div>
  ) : (
    <div class="flex-1 flex flex-col gap-4">
      {experiences.map((exp) => (
        <div
          class="flex
             flex-col
             sm:flex-row
             w-full
             items-center
             gap-5
             p-6
             rounded-xl
             border
             border-white/10
             bg-white/5
             backdrop-blur-md
             shadow-lg
             shadow-black/20"
        >
          <img
            src={urlFor(exp.logo).url()}
            alt={exp.role}
            class="w-20
               h-20
               sm:w-50
               sm:h-50
               rounded-full
               object-cover
               shrink-0
               border
               border-white/10"
          />
          <div class="flex flex-col gap-0.5 min-w-0 text-center sm:text-left">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-sm font-bold text-white text-start">
                {exp.role}
              </span>
              <span class="text-xs text-neutral-400 font-mono">{""}</span>
            </div>
            <span class="text-xs text-blue-300 text-start">{exp.orgName}</span>
            <p class="text-neutral-300 mt-1 leading-snug text-start">
              {exp.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  )
}

<script>
  import { navigate } from "astro:transitions/client";

  const button = document.getElementById("expand-btn");
  button?.addEventListener("click", () => {
    navigate("/about");
  });
</script>
