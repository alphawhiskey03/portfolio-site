---
import { GET_EXPEREINCES } from "@/queries";
import TestimonialsCard from "../vengance-ui/testimonials-card";
import { FaExpand } from "react-icons/fa";
import { sanityClient } from "sanity:client";

const { expanded = false } = Astro.props;
const experiences = await sanityClient.fetch(GET_EXPEREINCES);
console.log(experiences);
const Experiences = [
  {
    id: 1,
    title: "Userflow",
    subtitle: "Software Development Engineer",
    description:
      "Full stack work across the web app, SDK, and Chrome extension. On the AI side, built rephrasing tools, auto-localisation, onboarding flow generation, and product insights — practical AI features that ship, not prototypes.",
    period: "2024 - Present",
    image: "./images/userflow.jpeg",
  },
  {
    id: 2,
    title: "BookMyRide",
    subtitle: "Frontend Developer",
    description:
      "Built React components and REST APIs for a taxi booking platform. Owned frontend maintenance alongside backend development, integrating Mapbox for real-time ride tracking using Next.js and Redux.",
    period: "2024 - Present",
    image: "./images/bmr-round.png",
  },
  {
    id: 3,
    title: "Coko foundation",
    subtitle: "JavaScript Developer",
    description:
      "Full stack contributions to open-source scholarly publishing software. Learnt to navigate a large codebase, practise test-driven development, and work with real CI/CD pipelines. Working with the Coko team was one of the more formative parts of my career: brilliant, humble people from across the world, different backgrounds and time zones. I consider it a privilege.",
    period: "2024 - Present",
    image: "/images/coko.jpeg",
  },
  {
    id: 4,
    title: "KS Global",
    subtitle: "Web Developer",
    description:
      "Where my web development career started. Had the freedom to explore across the stack and across languages — and where I first understood what building for real clients actually means.",
    period: "2024 - Present",
    image: "/images/k_s_globals_logo.jpeg",
  },
];
---

{
  !expanded ? (
    <div class="flex-1 flex flex-col items-start">
      <p
        class="text-lg
        drop-shadow-sm
        w-3/4
        "
      >
        4 years across the full stack — frontend, backend, e2e pipelines, SDK
        internals, open source, and Chrome extensions. I've worked across the
        surface area of modern web engineering, and more recently a large part
        of my focus has been integrating AI into products in ways that actually
        matter — not experiments, features that ship and stick. I go as deep as
        the problem needs.
      </p>

      <div class="flex flex-row justify-between items-center w-3/4 my-8">
        <p class="text-xl font-bold text-white">Work Experience</p>
        <button
          id="expand-btn"
          class="flex items-center gap-2 text-sm text-neutral-400 cursor-pointer hover:text-white transition-colors"
        >
          <FaExpand />
          <span>Expand</span>
        </button>
      </div>
      <TestimonialsCard client:load width={600} items={Experiences} />
    </div>
  ) : (
    <div class="flex-1 flex flex-col gap-4">
      {Experiences.map((exp) => (
        <div
          class="flex
             flex-col
             sm:flex-row
             w-full
             items-center
             gap-5
             p-6
             rounded-xl
             border
             border-white/10
             bg-white/5
             backdrop-blur-md
             shadow-lg
             shadow-black/20"
        >
          <img
            src={exp.image}
            alt={exp.title}
            class="w-20
               h-20
               sm:w-50
               sm:h-50
               rounded-full
               object-cover
               shrink-0
               border
               border-white/10"
          />
          <div class="flex flex-col gap-0.5 min-w-0 text-center sm:text-left">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-sm font-bold text-white text-start">
                {exp.title}
              </span>
              <span class="text-xs text-neutral-400 font-mono">
                {exp.period}
              </span>
            </div>
            <span class="text-xs text-blue-300 text-start">{exp.subtitle}</span>
            <p class="text-neutral-300 mt-1 leading-snug text-start">
              {exp.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  )
}

<script>
  import { navigate } from "astro:transitions/client";

  const button = document.getElementById("expand-btn");
  button?.addEventListener("click", () => {
    navigate("/about");
  });
</script>
