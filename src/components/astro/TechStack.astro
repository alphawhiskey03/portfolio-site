---
import { FaReact, FaNodeJs } from "react-icons/fa";
import { GrGraphQl } from "react-icons/gr";
import { BsTypescript } from "react-icons/bs";
import {
  SiShadcnui,
  SiTailwindcss,
  SiPostgresql,
  SiMongodb,
  SiStorybook,
} from "react-icons/si";

// Group your icons into a clean configuration object
const stacks = [
  {
    title: "Core",
    items: [
      { name: "React", icon: FaReact },
      { name: "NodeJS", icon: FaNodeJs },
      { name: "GraphQL", icon: GrGraphQl },
      { name: "TypeScript", icon: BsTypescript },
    ],
  },
  {
    title: "UI",
    items: [
      { name: "Storybook", icon: SiStorybook },
      { name: "Shadcn UI", icon: SiShadcnui },
      { name: "Tailwind CSS", icon: SiTailwindcss },
    ],
  },
  {
    title: "DB",
    items: [
      { name: "PostgreSQL", icon: SiPostgresql },
      { name: "MongoDB", icon: SiMongodb },
    ],
  },
];

const { takeFullWidth = false } = Astro.props;
---

<div
  class:list={[
    "flex flex-col items-center gap-4 mt-10",
    { "flex-1": takeFullWidth },
  ]}
>
  {
    stacks.map((section) => (
      <>
        <p class="text-md lg:text-2xl font-bold font-space">{section.title}</p>

        <div class="flex items-center gap-4 flex-wrap">
          {section.items.map(({ name, icon: Icon }) => (
            <div
              aria-label={name}
              class="p-4 
                 rounded-xl 
                 text-5xl 
                 border 
                 border-white/10 
                 bg-white/5 
                 backdrop-blur-md 
                 shadow-lg 
                 shadow-black/20 
                 transition-all 
                 duration-200 
                 cursor-pointer 
                 hover:bg-white/10 
                 hover:border-blue-300 
                 hover:text-blue-300"
            >
              <Icon />
            </div>
          ))}
        </div>
      </>
    ))
  }
</div>
