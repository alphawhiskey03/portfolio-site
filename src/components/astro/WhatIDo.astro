---
// WhatIDo.astro
import { FaReact, FaNodeJs } from "react-icons/fa";
import { GrGraphQl } from "react-icons/gr";
import { BsJavascript } from "react-icons/bs";
import {
  SiMongodb,
  SiStripe,
  SiN8N,
  SiSocketdotio,
  SiStorybook,
} from "react-icons/si";
import { IoExtensionPuzzleOutline } from "react-icons/io5";

const items = [
  {
    title: "UI & SDK",
    description:
      "I build and maintain high-performance SDKs, custom Chrome extensions, and scalable component libraries that developers actually want to use. I focus on creating bulletproof interfaces and seamless browser tooling.",
    technologies: [
      { title: "React", icon: FaReact },
      { title: "JavaScript", icon: BsJavascript },
      { title: "WebSockets", icon: SiSocketdotio },
      { title: "Storybook", icon: SiStorybook },
      { title: "Chrome extensions", icon: IoExtensionPuzzleOutline },
    ],
  },
  {
    title: "Full stack applications",
    description:
      "I architect resilient, production-ready full-stack applications complete with secure authentication, Stripe payment systems, heavy test coverage, and the automated infrastructure holding it all together.",
    technologies: [
      { title: "Node.js", icon: FaNodeJs },
      { title: "GraphQL", icon: GrGraphQl },
      { title: "Stripe", icon: SiStripe },
      { title: "MongoDB", icon: SiMongodb },
    ],
  },
  {
    title: "AI workflows",
    description:
      "I integrate AI where it actually adds value to a product—not gimmick wrappers. I build out advanced RAG pipelines, contextual vector search setups, and intelligent automation workflows that handle complex business logic.",
    technologies: [{ title: "N8n", icon: SiN8N }, { title: "ChromaDB" }],
  },
];

const { centerContent = false } = Astro.props;
---

<div
  class:list={[
    "flex flex-col gap-4 items-start",
    { "items-end-safe": centerContent },
  ]}
>
  {
    items.map((item) => (
      <div
        class="
        w-full
      rounded-md 
      border 
      border-white/10
      bg-white/5 
       p-4 
       backdrop-blur-md 
       shadow-lg 
       shadow-black/20"
      >
        <h3 class="text-lg  font-mono mb-2 font-bold">{item.title}</h3>
        <p>{item.description}</p>

        <div
          class="flex 
             flex-wrap 
             items-center 
             gap-2 
             mt-4"
        >
          {item.technologies.map((tech) => {
            const Icon = tech.icon;
            return (
              <div
                class="flex 
                   items-center 
                   gap-2 
                   border 
                   border-white/10 
                   rounded-md 
                   p-2 
                   cursor-pointer 
                   hover:border-blue-300
                   group
                   font-mono
                   text-xs
                   "
              >
                {Icon && (
                  <span class="group-hover:text-blue-300">
                    <Icon />
                  </span>
                )}
                <span class="text-xs">{tech.title}</span>
              </div>
            );
          })}
        </div>
      </div>
    ))
  }
</div>
