---
import { GET_EXPEREINCES } from "@/queries";
import ExperienceCard from "../vengance-ui/experience-card";
import { FaExpand, FaEye } from "react-icons/fa";
import { sanityClient } from "sanity:client";
import type { Experience } from "@/queries/types";
import { urlFor } from "@/utils";
import IconComponent from "../client/IconComponent";

const { expanded = false, aboutMe } = Astro.props;
const experiences: Experience[] = await sanityClient.fetch(GET_EXPEREINCES);
---

{
  !expanded ? (
    <div class="flex-1 flex flex-col items-start">
      <p
        class="text-lg
        drop-shadow-sm
        w-full
        font-mono
        "
      >
        {aboutMe}
      </p>

      <div class="flex flex-row justify-between items-center w-full my-8">
        <p class="text-xl font-bold text-white font-mono">Work Experience</p>
        <a
          href="/about#work-experience"
          class="flex 
          items-center 
          gap-2 
          text-sm 
          text-neutral-400 
          cursor-pointer 
          lg:mr-16
          hover:text-white 
          transition-colors"
        >
          <FaEye />
          <span>More details</span>
        </a>
      </div>
      <ExperienceCard client:load width={600} items={experiences} />
    </div>
  ) : (
    <div class="flex-1 flex flex-col gap-4">
      {experiences.map((exp) => (
        <div
          id={exp.orgSlug.current}
          class="flex flex-col sm:flex-row w-full items-center gap-5 p-6 rounded-xl border border-white/10 bg-white/5 backdrop-blur-md shadow-lg shadow-black/20"
        >
          <img
            src={urlFor(exp.logo).url()}
            alt={exp.orgName}
            data-org-link={exp.orgLink}
            class="w-20
               h-20
               sm:w-50
               sm:h-50
               rounded-full
               object-cover
               shrink-0
               border
               border-white/10
               cursor-pointer"
          />
          <div class="flex flex-col gap-0.5 min-w-0 text-center sm:text-left">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-sm font-bold text-white text-start">
                {exp.role}
              </span>
              <span class="text-xs text-neutral-400 font-mono">{""}</span>
            </div>
            <a
              href={exp.orgLink}
              target="_blank"
              class="text-xs text-blue-300 text-start"
            >
              {exp.orgName}
            </a>
            <p class="text-neutral-300 mt-1 leading-snug text-start">
              {exp.description}
            </p>
            <div class="flex flex-row gap-2 mt-2 flex-wrap">
              {exp.technologies.map((tech) => (
                <div
                  class="flex 
                   items-center 
                   gap-2 
                   border 
                   border-white/10 
                   rounded-md 
                   p-2 
                   cursor-pointer 
                   hover:border-blue-300
                   group"
                >
                  {tech.icon && (
                    <span class="group-hover:text-blue-300">
                      <IconComponent
                        client:load
                        packageName={tech.icon.packageName}
                        icon={tech.icon.name}
                        iconProps={{}}
                      />
                    </span>
                  )}
                  <span class="text-xs font-mono">{tech.title}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  )
}

<script>
  document.addEventListener("click", (event) => {
    const img = (event.target as HTMLElement)?.closest<HTMLImageElement>(
      "img[data-org-link]",
    );
    if (img?.dataset.orgLink) {
      window.open(img.dataset.orgLink, "_blank");
    }
  });

  function scrollToViewportCenter(el: HTMLElement) {
    const scroll = () => {
      const { top, height } = el.getBoundingClientRect();
      window.scrollTo({
        top: window.scrollY + top - window.innerHeight / 2 + height / 2,
        behavior: "smooth",
      });
    };

    if (document.readyState === "complete") {
      requestAnimationFrame(scroll);
    } else {
      window.addEventListener("load", () => requestAnimationFrame(scroll), {
        once: true,
      });
    }
  }

  const highlightedOrg = new URLSearchParams(window.location.search).get("org");
  if (highlightedOrg) {
    const el = document.getElementById(highlightedOrg);
    if (el) {
      el.classList.replace("border-white/10", "border-blue-300");
      scrollToViewportCenter(el);
    }
  }
</script>
