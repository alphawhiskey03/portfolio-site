---
import "../styles/global.css";
import { NeuroNoiseBackground } from "../components/client/NeuroNoiseBackground";
import SectionNav, {
  type SectionNavItem,
} from "../components/astro/SectionNav.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Sections to list in the floating nav. Omit to render no nav. */
  nav?: SectionNavItem[];
}

const {
  title = "Vignesh Shanmugavelu | Software Development Engineer",
  description = "Full-Stack Engineer (4 years exp) building web apps, SDKs, and browser extensions with a focus on practical AI engineering. Based in Coimbatore, India.",
  ogImage = "/images/portfolio-banner.png",
  nav,
} = Astro.props;

const canonicalURL = Astro.url.href;
const ogImageURL = new URL(ogImage, Astro.site ?? Astro.url).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Vignesh Shanmugavelu",
  url: Astro.site?.href ?? canonicalURL,
  jobTitle: "Software Development Engineer",
  description,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph — WhatsApp, Slack, Teams, Instagram DMs, LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="therealvig" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@therealvig" />
    <meta name="twitter:site" content="@therealvig" />

    <!-- JSON-LD structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <NeuroNoiseBackground client:idle />
    {nav && <SectionNav items={nav} />}
    <main class="w-full min-h-screen">
      <div class="p-6 lg:p-10">
        <slot />
      </div>
    </main>
    <footer class="px-6 pb-10 pt-28 lg:px-10 lg:pt-40">
      <p
        class="max-w-3xl font-space text-2xl font-medium leading-tight tracking-tight text-white lg:text-4xl"
      >
        Thanks for scrolling
        <span data-scroll-count class="tabular-nums text-blue-300" hidden
        ></span>
        all the way down.
      </p>
      <p class="mt-6 text-base text-neutral-400">
        made with
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-200 transition-colors hover:text-blue-300"
          >Astro</a
        >,
        <a
          href="https://tailwindcss.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-200 transition-colors hover:text-blue-300"
          >Tailwind</a
        >
        &amp;
        <a
          href="https://www.sanity.io"
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-200 transition-colors hover:text-blue-300"
          >Sanity CMS</a
        >
      </p>
      <p class="mt-1 text-base text-neutral-400">
        © {new Date().getFullYear()} therealvig
      </p>
    </footer>

    <script>
      // "Thanks for scrolling N px all the way down": N is the visitor's real
      // scroll distance when the footer enters, counted up once. Without JS the
      // line simply reads "all the way down".
      const counter = document.querySelector<HTMLElement>(
        "[data-scroll-count]",
      );
      const footer = counter?.closest("footer");

      if (counter && footer) {
        const reduceMotion = matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const format = (n: number) =>
          `${Math.round(n).toLocaleString("en-US")} px`;

        const reveal = () => {
          const target = Math.round(window.scrollY);
          if (target < 100) return; // short page: keep the plain line
          counter.hidden = false;
          if (reduceMotion) {
            counter.textContent = format(target);
            return;
          }
          const duration = 1400;
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            counter.textContent = format(target * eased);
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              observer.disconnect();
              reveal();
            }
          },
          { threshold: 0.4 },
        );
        observer.observe(footer);
      }
    </script>
  </body>
</html>
